SOLARIS_WEB_WS_POLL_SECONDS=1.5
SOLARIS_SCOPE_TENANT=personal
SOLARIS_SCOPE_NAMESPACE=solaris
SOLARIS_SCOPE_WORKSPACE=default
SOLARIS_SCOPE_PROJECT=default
