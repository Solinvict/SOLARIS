SOLARIS_DB_PATH=.runtime/solaris.db
SOLARIS_POLICIES_DIR=policies
SOLARIS_DEFAULT_POLICY_PROFILE=default_v1
SOLARIS_FTS_ENABLED=true
SOLARIS_EMBEDDINGS_ENABLED=false
SOLARIS_LOG_LEVEL=INFO
